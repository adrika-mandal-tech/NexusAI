# ─── NexusAI — Root Workspace / Docker Compose Variables ───
# Copy this file to .env if overriding root workspace settings.
# Service secrets and API keys live in apps/backend/.env
# Frontend API base URL lives in apps/frontend/.env.local

COMPOSE_PROJECT_NAME=nexusai

# Postgres (aligned with docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexusai

# Redis
REDIS_URL=redis://redis:6379/0

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
