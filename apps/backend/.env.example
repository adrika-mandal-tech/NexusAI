ENVIRONMENT=development
APP_NAME=nexusai-backend
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Generate a strong random secret for production (e.g. `openssl rand -hex 32`)
AUTH_SECRET_KEY=change-this-to-a-long-random-secret-in-production
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=10080

BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# ── Database & Workers ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexusai
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY_WORKERS=auto

# ── LLM / Embeddings ─────────────────────────────────────────
# Comma-separated API keys for rotation
GOOGLE_API_KEYS=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite
DEFAULT_GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEYS=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
DEFAULT_GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=auto

EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3

# ── Observability (LangSmith) ────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nexusai
LANGCHAIN_TRACING_V2=false

# ── Vector DB ────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nexusai_documents
QDRANT_CLUSTER_ENDPOINT=
QDRANT_CLUSTER_API_KEY=

# ── Knowledge Graph ──────────────────────────────────────────
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
NEO4J_POOL_SIZE=50

# A separate account for the natural-language graph query path. Provision it
# once with:  python scripts/setup_neo4j_readonly.py
# While it is unset the NL query path is DISABLED — it never falls back to
# the administrative account above.
# Note: Neo4j Community has no fine-grained privilege system, so on Community
# the account is an identity boundary, not a privilege boundary. The
# application-side read-only guard is what enforces read-only behaviour.
NEO4J_READONLY_USER=
NEO4J_READONLY_PASSWORD=

# ── CSV → Knowledge Graph ingestion ───────────────────────────
CSV_MAX_UPLOAD_BYTES=104857600
CSV_MAX_ROWS=1000000
CSV_MAX_COLUMNS=1000
CSV_MAX_CELL_BYTES=65536
CSV_MAX_FILES=20
CSV_PROFILE_SAMPLE_ROWS=20000
CSV_INGEST_BATCH_SIZE=1000
CSV_FK_OVERLAP_STRONG=0.95
CSV_FK_OVERLAP_MIN=0.60
CSV_KEY_SCORE_ACCEPT=60
UPLOAD_DIR=.data/uploads

# ── Graph query safety ────────────────────────────────────────
GRAPH_QUERY_MAX_ROWS=200
GRAPH_QUERY_TIMEOUT_MS=5000
GRAPH_QUERY_MAX_RETRIES=1

# ── Search ───────────────────────────────────────────────────
TAVILY_API_KEY=

# ── Hugging Face ─────────────────────────────────────────────
HF_API_KEY=

# ── NEXUS_* aliases (fallback when primary vars are empty) ───
NEXUS_GEMINI_API_KEY=
NEXUS_GROQ_API_KEY=
NEXUS_TAVILY_API_KEY=
NEXUS_LANGSMITH_API_KEY=
NEXUS_HF_API_KEY=
NEXUS_QDRANT_URL=
NEXUS_QDRANT_API_KEY=
NEXUS_CLUSTER_ENDPOINT=
NEXUS_QDRANT_ID=
